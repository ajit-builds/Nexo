# ============================================================
# NEXO CREDENTIAL NETWORK — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development, or add
# these key-value pairs into your Vercel Project Settings:
# (Vercel Dashboard -> Project -> Settings -> Environment Variables)
# ============================================================

# ------------------------------------------------------------
# 1. APP CONFIGURATION
# ------------------------------------------------------------
# In Vercel, set this to your Vercel URL (e.g. https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="production"

# ------------------------------------------------------------
# 2. BLOCKCHAIN — POLYGON AMOY TESTNET (chainId: 80002)
# ------------------------------------------------------------
NEXT_PUBLIC_POLYGON_AMOY_RPC="https://rpc-amoy.polygon.technology"
ALCHEMY_AMOY_RPC_URL="https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# Deployer / Relayer testnet private key (Relayer gas sponsor)
DEPLOYER_PRIVATE_KEY=""
RELAYER_PRIVATE_KEY=""

# ------------------------------------------------------------
# 3. DEPLOYED SMART CONTRACT ADDRESSES (Polygon Amoy)
# ------------------------------------------------------------
NEXT_PUBLIC_TRUST_REGISTRY_ADDRESS="0xEC3984A0692dDCE5c6fD604Fe0A7ba4d8fC13Be2"
NEXT_PUBLIC_CREDENTIAL_ANCHOR_ADDRESS="0x42254C752a6705c69ce9a1BFbd0E2111c2CBF649"
NEXT_PUBLIC_REVOCATION_REGISTRY_ADDRESS="0xA2c85e22ab1D6Cd91CeF3259888cBf0ff3e80a59"

# Contract verification
POLYGONSCAN_API_KEY=""

# ------------------------------------------------------------
# 4. IPFS / PINATA (Decentralized Credential Storage)
# ------------------------------------------------------------
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""
PINATA_JWT=""
NEXT_PUBLIC_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"

# ------------------------------------------------------------
# 5. DATABASE (Prisma)
# ------------------------------------------------------------
# For local development: file:./prisma/dev.db
# For Vercel production: PostgreSQL connection string (Neon / Supabase / Vercel Postgres)
DATABASE_URL="file:./prisma/dev.db"
