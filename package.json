{
  "name": "nexo-credential-network",
  "version": "1.0.0",
  "private": true,
  "description": "Tamper-proof digital verifiable credential network for universities, students, and recruiters on Polygon Amoy.",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start",
    "lint": "next lint",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "export:abi": "node scripts/export-abi.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.js --network amoy",
    "verify:amoy": "hardhat run scripts/verify.js --network amoy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2",
    "@openzeppelin/merkle-tree": "^1.0.6",
    "@pinata/sdk": "^3.0.2",
    "@prisma/client": "^5.22.0",
    "@sd-jwt/core": "^0.7.2",
    "@sd-jwt/decode": "^0.7.2",
    "@sd-jwt/types": "^0.7.2",
    "@tanstack/react-query": "^5.108.2",
    "ethers": "^6.13.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.395.0",
    "next": "^14.2.4",
    "papaparse": "^5.4.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.58.4",
    "wagmi": "^3.7.11"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/node": "^20.14.9",
    "@types/papaparse": "^5.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "hardhat": "^2.22.5",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2"
  }
}
